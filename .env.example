# Copy to .env.local and fill in values. Never commit real credentials.
# All settings below are used by the app.

# AI provider selection (provider-agnostic; see docs/ai-enrichment.md)
# AI_PROVIDER: gemini (default) or openrouter
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Optional: override the provider's default model.
# AI_MODEL=
# Optional: how long an enrich:ai run holds its claim on an item (ms) before
# another run may take it over (e.g. after a crash). Default 600000 (10 minutes).
# AI_ENRICHMENT_LEASE_MS=600000

# Which archive the app and CLIs use: "personal" (default) or "demo".
# Normally left unset; npm run dev:demo / start:demo / demo:seed set it for you.
# ARCHIVE_DATA_SOURCE=personal

# Optional: where the demo archive lives (default ./demo-data/). It must not
# overlap the personal archive's locations below; the app refuses if it does.
# DEMO_DATABASE_PATH=./demo-data/archive.sqlite
# DEMO_MEDIA_STORAGE_DIR=./demo-data/media

# Local storage locations of the personal archive (relative to the project root)
DATABASE_PATH=./data/insta-archive.sqlite
MEDIA_STORAGE_DIR=./data/media

# Reels whose downloaded video is larger than this (bytes) are kept as up to 8
# JPEG frames plus the creator's cover instead of the video (see
# docs/media-retrieval.md). Default 10000000 (10 MB).
REEL_MAX_RETAINED_VIDEO_BYTES=10000000
