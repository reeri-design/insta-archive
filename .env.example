# Copy to .env.local and fill in values. Never commit real credentials.
# DATABASE_PATH and MEDIA_STORAGE_DIR are used; the AI settings document planned configuration.

# AI provider selection (provider-agnostic; "anthropic" is the first implementation)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Local storage locations (relative to the project root)
DATABASE_PATH=./data/insta-archive.sqlite
MEDIA_STORAGE_DIR=./data/media

# EXPERIMENTAL: Reels whose downloaded video is larger than this (bytes) are kept
# as frames instead of the video (one frame every 4–12 s depending on size; see
# docs/media-retrieval.md). Default 20000000 (20 MB).
REEL_MAX_RETAINED_VIDEO_BYTES=20000000
